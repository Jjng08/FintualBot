# ============================================
# VTI Gap Trading Alert - Configuration
# ============================================
# This file documents all required environment variables for the trading bot.
# Copy this file to .env and fill in your actual values.

# ============================================
# Telegram Configuration (REQUIRED)
# ============================================
# Bot token from @BotFather on Telegram
# Get it by creating a new bot: https://t.me/BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Chat ID where alerts will be sent
# Get it by messaging your bot and visiting: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# MongoDB connection URI
# Format: mongodb://[username:password@]host[:port]/database
# Example local: mongodb://localhost:27017/trading-bot
# Example Atlas: mongodb+srv://user:pass@cluster.mongodb.net/trading-bot
MONGO_URI=mongodb://localhost:27017/trading-bot

# ============================================
# Market Data API Configuration (REQUIRED)
# ============================================
# Primary API key for market data (e.g., Alpha Vantage, Yahoo Finance)
PRIMARY_API_KEY=your_primary_api_key_here

# Optional secondary API key for fallback
# SECONDARY_API_KEY=your_secondary_api_key_here

# ============================================
# Fintual Configuration (OPTIONAL)
# ============================================
# Credenciales de tu cuenta Fintual para acceder a todos los fondos disponibles
# Si no se configuran, solo se usan datos públicos (fondos limitados)
FINTUAL_USER=tu_email@ejemplo.com
FINTUAL_PASSWORD=tu_contraseña_fintual

# ============================================
# Trading Configuration (OPTIONAL)
# ============================================
# Comma-separated list of asset symbols to monitor
# Default: VTI
# Examples: VTI,SPY,QQQ or AAPL,MSFT,GOOGL
ASSET_LIST=VTI

# Percentage change threshold to trigger alerts (%)
# Default: 1.5
# The bot will alert when an asset rises by this percentage or more
PRICE_CHANGE_THRESHOLD=1.5

# Price monitoring interval in minutes
# Default: 5
# How often to check prices during the trading window
MONITORING_INTERVAL=5

# ============================================
# Schedule Configuration (OPTIONAL)
# ============================================
# Trading window start time (HH:mm format, 24-hour)
# Default: 11:30 (when NYSE opens in Chilean time)
START_TIME=11:30

# Trading window end time (HH:mm format, 24-hour)
# Default: 13:30 (when Fintual updates prices)
END_TIME=13:30

# Timezone for all time calculations
# Default: America/Santiago
# Must be a valid IANA timezone identifier
TIMEZONE=America/Santiago
